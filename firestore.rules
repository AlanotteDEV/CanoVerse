rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Unico punto in cui è definito chi è l'amministratore. Il confronto è
    // su email minuscola: Firebase Auth normalizza l'indirizzo, quindi
    // scriverlo con la maiuscola nelle regole basterebbe a non far
    // riconoscere più l'admin.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email.lower() == 'canoversecomicscosplay@gmail.com';
    }

    // Contatore atomico dei posti occupati al torneo One Piece Card Game.
    // Il documento meta/tcg_onepiece_count DEVE esistere già (va creato una
    // tantum a mano dalla Firebase Console, vedi istruzioni di migrazione)
    // con { count: <numero di iscrizioni tcg_onepiece già esistenti> }.
    match /meta/tcg_onepiece_count {
      allow read: if true;
      allow create: if false;
      // Due sole variazioni ammesse, entrambe di una unità:
      //  +1  chiunque si iscriva, finché restano posti (tetto: 20);
      //  -1  solo l'admin, quando cancella un iscritto dalla pagina
      //      partecipanti, e mai sotto zero.
      // Nessuno può scrivere un valore arbitrario: il contatore si muove
      // solo di pari passo con le iscrizioni reali.
      allow update: if request.resource.data.keys().hasOnly(['count']) && (
                      (request.resource.data.count == resource.data.count + 1 &&
                       resource.data.count < 20) ||
                      (isAdmin() &&
                       request.resource.data.count == resource.data.count - 1 &&
                       resource.data.count > 0)
                    );
      allow delete: if false;
    }

    match /registrations/{docId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['name', 'character', 'category', 'timestamp']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        // Elenco chiuso delle categorie: va tenuto allineato al menu
        // "Categoria" di iscrizione.html, altrimenti chi sceglie una gara
        // nuova riceve un permission-denied e non riesce a iscriversi.
        request.resource.data.category in ['cosplay_singolo', 'cosplay_gruppo', 'kpop', 'tcg_onepiece', 'workshop_cucito'] &&
        (!('character' in request.resource.data) ||
          (request.resource.data.character is string && request.resource.data.character.size() <= 80)) &&
        request.resource.data.timestamp == request.time &&
        // Per il torneo One Piece, la creazione è ammessa solo se il
        // contatore sopra ha già superato la sua validazione (< 20 prima
        // dell'incremento): le due scritture avvengono nella stessa
        // transazione lato client, quindi se il contatore viene rifiutato
        // l'intera transazione (incluso questo documento) fallisce.
        (request.resource.data.category != 'tcg_onepiece' ||
          get(/databases/$(database)/documents/meta/tcg_onepiece_count).data.count <= 20);

      allow update, delete: if isAdmin();
    }

    // Registro dei consensi cookie (prova ex art. 7 GDPR). Chiunque può
    // creare un record di consenso (vincolato nei campi e senza dati
    // identificativi); solo l'admin può leggerlo; nessuno può modificarlo
    // o cancellarlo, per garantirne l'integrità come prova.
    match /cookie_consents/{docId} {
      allow read: if isAdmin();

      allow create: if
        request.resource.data.keys().hasOnly(['necessary', 'statistics', 'thirdparty', 'policyVersion', 'page', 'userAgent', 'timestamp']) &&
        request.resource.data.necessary == true &&
        request.resource.data.statistics is bool &&
        request.resource.data.thirdparty is bool &&
        request.resource.data.policyVersion is int &&
        request.resource.data.page is string &&
        request.resource.data.page.size() <= 200 &&
        request.resource.data.userAgent is string &&
        request.resource.data.userAgent.size() <= 400 &&
        request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }
  }
}
